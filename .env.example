# Server Configuration
PORT=3001
CLIENT_PORT=5173

# LLM Providers Configuration (comma-separated keys for round-robin & failover)
LLM_PROVIDER_ORDER=groq,gemini,openai,anthropic

# Groq High-Speed Ultra-fast Provider
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEYS=sk-key1,sk-key2
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEYS=sk-ant-key1,sk-ant-key2
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Search Providers Configuration (Automatic Discovery - Step 3B)
SEARCH_PROVIDER_ORDER=tavily,brave
TAVILY_API_KEYS=tvly-key1,tvly-key2
BRAVE_API_KEYS=BSAI-key1,BSAI-key2
MAX_SOURCES=6


